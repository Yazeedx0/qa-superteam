{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-superteam.dev/schemas/TestExecution.schema.json",
  "title": "TestExecution",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "adapter": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "duration_s": {
      "type": "number"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "timed_out": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestResult"
      }
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentInfo"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why the overall status was assigned (always set for BLOCKED/ERROR/NOT_RUN/INCONCLUSIVE)"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempt": {
      "type": "integer"
    },
    "reproduction_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Test identifier this execution re-ran for reproduction"
    },
    "actor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Agent or person that ran it (qast exec --actor); verification requires the verifier's own executions"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "adapter",
    "status",
    "started_at",
    "finished_at",
    "duration_s",
    "command",
    "cwd",
    "exit_code",
    "timed_out",
    "counts",
    "results",
    "environment"
  ],
  "description": "One adapter invocation and its normalized results.",
  "$defs": {
    "EnvironmentInfo": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "hostname_hash": {
          "type": "string",
          "description": "sha256 prefix of hostname; raw hostname is never stored"
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ci": {
          "type": "boolean"
        },
        "git_head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "git_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "platform",
        "python",
        "hostname_hash"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED",
        "ERROR",
        "SKIPPED",
        "BLOCKED",
        "NOT_RUN",
        "INCONCLUSIVE"
      ],
      "description": "Normalized execution status. Never collapse to pass/fail."
    },
    "TestResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic: hash of adapter + identifier"
        },
        "identifier": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "identifier",
        "status"
      ],
      "description": "Outcome of one test within an execution."
    }
  }
}
