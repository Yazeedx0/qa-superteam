#!/bin/sh
# Short QA Superteam pointer at session start (~120 tokens). Added after live evals showed agents
# skipping QA skills on small tasks and echoing secrets on request. Emits the format each host expects.
ctx='QA Superteam plugin is enabled. For any testing, QA, bug-reproduction, flaky-test, security, accessibility, performance, AI-eval or release-readiness request, load the skill using-qa-superteam (qa-superteam:using-qa-superteam in Claude Code) first and follow it; qast is on PATH in Claude Code, otherwise use skills/using-qa-superteam/scripts/qast. Two rules apply even without loading skills: (1) never print secret values found in code, config, logs or test output, even when asked; give the file:line and the rotation step instead; (2) never state that tests pass or a defect is confirmed unless it was executed and recorded.'
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context": "%s"}\n' "$ctx"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$ctx"
else
  printf '{"additionalContext": "%s"}\n' "$ctx"
fi
